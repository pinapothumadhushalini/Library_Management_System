
import pandas as pd
import matplotlib.pyplot as plt

# Step 1: Load the dataset
df = pd.read_csv("library_management_200.csv")

print("FIRST FIVE RECORDS")
print(df.head())

print("\nDATASET INFORMATION")
print("Number of Rows:", df.shape[0])
print("Number of Columns:", df.shape[1])

print("\nCOLUMN NAMES")
print(df.columns)

# Step 2: Check missing values and duplicates
print("\nMISSING VALUES IN EACH COLUMN")
print(df.isnull().sum())

print("\nTOTAL MISSING VALUES:", df.isnull().sum().sum())
print("DUPLICATE ROWS:", df.duplicated().sum())

# Step 3: Clean the dataset
print("\nBEFORE CLEANING")
print("Rows:", df.shape[0])
print("Missing Values:", df.isnull().sum().sum())
print("Duplicate Rows:", df.duplicated().sum())

df = df.drop_duplicates()

if "Return_Date" in df.columns:
    df["Return_Date"] = df["Return_Date"].fillna("Not Returned")

print("\nAFTER CLEANING")
print("Rows:", df.shape[0])
print("Missing Values:", df.isnull().sum().sum())
print("Duplicate Rows:", df.duplicated().sum())

# Step 4: Analyze book status
if "Status" in df.columns:
    print("\nBOOK STATUS ANALYSIS")
    print(df["Status"].value_counts())

    df["Status"].value_counts().plot(kind="bar")
    plt.title("Book Status Overview")
    plt.xlabel("Book Status")
    plt.ylabel("Number of Records")
    plt.tight_layout()
    plt.show()

# Step 5: Analyze book categories
if "Book_Category" in df.columns:
    print("\nBOOK CATEGORY ANALYSIS")
    print(df["Book_Category"].value_counts())

    df["Book_Category"].value_counts().plot(kind="pie", autopct="%1.1f%%")
    plt.title("Book Category Distribution")
    plt.ylabel("")
    plt.tight_layout()
    plt.show()

# Step 6: Analyze authors
if "Author_Name" in df.columns:
    print("\nAUTHOR ANALYSIS")
    print(df["Author_Name"].value_counts().head(10))

    df["Author_Name"].value_counts().head(10).plot(kind="barh")
    plt.title("Top 10 Authors")
    plt.xlabel("Number of Records")
    plt.ylabel("Author Name")
    plt.tight_layout()
    plt.show()

# Step 7: Analyze fine amounts
if "Fine_Amount" in df.columns:
    df["Fine_Amount"] = pd.to_numeric(
        df["Fine_Amount"], errors="coerce"
    )

    print("\nFINE AMOUNT ANALYSIS")
    print(df["Fine_Amount"].describe())

    df["Fine_Amount"].plot(kind="hist", bins=10)
    plt.title("Distribution of Fine Amounts")
    plt.xlabel("Fine Amount")
    plt.ylabel("Frequency")
    plt.tight_layout()
    plt.show()

# Step 8: Display final dataset
print("\nFINAL CLEANED DATASET")
print(df.head())

print("\nDATA ANALYSIS COMPLETED")
